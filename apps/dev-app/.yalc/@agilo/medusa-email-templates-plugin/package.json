{
  "name": "@agilo/medusa-email-templates-plugin",
  "version": "1.0.0-beta.0",
  "description": "Manage transactional email templates from Medusa Admin and send them through Medusa Cloud, Resend or Mailgun.",
  "author": "Agilo (https://agilo.com)",
  "license": "MIT",
  "homepage": "https://github.com/Agilo/medusa-email-templates-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agilo/medusa-email-templates-plugin.git",
    "directory": "packages/medusa-email-templates-plugin"
  },
  "bugs": {
    "url": "https://github.com/Agilo/medusa-email-templates-plugin/issues"
  },
  "files": [
    ".medusa/server"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": "./.medusa/server/src/registry.js",
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-notification",
    "email",
    "email-templates",
    "notification",
    "resend",
    "mailgun"
  ],
  "scripts": {
    "build": "yarn plugin:build",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "patch:dev": "node ../../scripts/apply-dev-patches.cjs",
    "plugin:build": "medusa plugin:build && node ./scripts/write-admin-safelist.mjs",
    "plugin:dev:medusa": "medusa plugin:develop",
    "plugin:publish:local": "medusa plugin:publish",
    "prepublishOnly": "medusa plugin:build && node ./scripts/write-admin-safelist.mjs",
    "test": "yarn test:unit && yarn test:backend && yarn test:admin",
    "test:admin": "yarn patch:dev && vitest run --passWithNoTests",
    "test:unit": "yarn patch:dev && vitest run --config vitest.config.unit.ts --passWithNoTests",
    "test:backend": "sh -c 'if test \"$DEVCONTAINER\" = \"true\"; then DB_HOST=postgres_test DB_PORT=5432 DB_USERNAME=postgres DB_PASSWORD=postgres DATABASE_URL=postgres://postgres:postgres@postgres_test:5432/postgres?sslmode=disable REDIS_URL=redis://redis_test:6379 yarn test:integration:module && DB_HOST=postgres_test DB_PORT=5432 DB_USERNAME=postgres DB_PASSWORD=postgres DATABASE_URL=postgres://postgres:postgres@postgres_test:5432/postgres?sslmode=disable REDIS_URL=redis://redis_test:6379 yarn test:integration:http; else yarn test:integration:module && yarn test:integration:http; fi'",
    "test:integration:http": "yarn patch:dev && TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --forceExit --maxWorkers=4",
    "test:integration:module": "yarn patch:dev && TEST_TYPE=integration:module NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p src/admin/tsconfig.json"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.21.0",
    "@medusajs/framework": "^2.21.0",
    "@medusajs/icons": "^2.21.0",
    "@medusajs/medusa": "^2.21.0",
    "@medusajs/ui": "^4.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "dependencies": {
    "@medusajs/dashboard": "^2.21.0",
    "@react-email/editor": "1.7.7",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "html-to-text": "^9.0.5",
    "liquidjs": "^10.29.0",
    "resend": "6.28.0",
    "zod": "4.2.0"
  },
  "yalcSig": "0d50fa5990ebfd5ca1eef90f02b708a9"
}
